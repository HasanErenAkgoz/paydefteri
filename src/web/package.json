{
  "name": "paydefteri-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration=mobile",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:web": "node dist/web/server/server.mjs"
  },
  "private": true,
