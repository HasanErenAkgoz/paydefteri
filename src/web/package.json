    "@angular/platform-browser-dynamic": "^21.2.20",
    "@angular/platform-server": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@angular/ssr": "^21.2.21",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
